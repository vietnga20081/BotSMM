# ========================
# TELEGRAM
# ========================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_IDS=123456789,987654321

# ========================
# MYSQL
# ========================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smm_bot
DB_USER=root
DB_PASSWORD=your_password

# ========================
# REDIS
# ========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ========================
# JWT (Admin API)
# ========================
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=8h

# ========================
# ADMIN LOGIN
# ========================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_password_here

# ========================
# APP
# ========================
NODE_ENV=production
PORT=3721
APP_URL=https://botsmm.v3vn.eu
CORS_ORIGIN=https://botsmm.v3vn.eu

# ========================
# SEPAY WEBHOOK (Nạp tiền)
# ========================
SEPAY_SECRET_KEY=your_sepay_secret_key
SEPAY_BANK_ACCOUNT=your_bank_account_number
SEPAY_BANK_NAME=MB

# ========================
# PROVIDER (Kingsmm)
# ========================
KINGSMM_API_URL=https://kingsmm.vn/api/v2
KINGSMM_API_KEY=your_kingsmm_api_key

# ========================
# PROFIT (%)
# ========================
DEFAULT_PROFIT_PERCENT=30

# ========================
# CURRENCY
# ========================
USD_TO_VND=25000
